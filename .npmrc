# engine-strict: fail install rather than silently run on a Node major this workspace's
# packages did not declare support for (see resources/js/package.json engines).
engine-strict=true

# save-exact: new devDependencies are pinned to an exact version by default, matching this
# repository's practice of re-verifying and pinning JS package versions rather than trusting
# a caret range (a stale-version incident is already on record for this project).
save-exact=true
